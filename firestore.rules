rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only the designated store manager account may change catalogue data
    // or read customer orders. A random account created with the public
    // web API key must not gain admin powers.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@odwear.store';
    }

    // The catalogue is public and read-only for visitors.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Visitors can place orders; only the admin can read/manage them.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
